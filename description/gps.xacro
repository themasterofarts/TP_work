<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Joint fixe entre le châssis et le GNSS -->
  <joint name="gnss_joint" type="fixed">
    <parent link="chassis"/>
    <child link="gnss_frame"/>
    <origin xyz="1.3 0.75 0.60" rpy="0 0 0"/>
  </joint>

  <!-- Lien du capteur GNSS (petit cylindre pour le visuel) -->
  <link name="gnss_frame">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.5"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.5"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.05" length="0.5" radius="0.03">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder> 
  </link>

  <!-- Capteur GNSS compatible Fortress -->
  <gazebo reference="gnss_frame">
    <sensor name="gnss_sensor" type="gps">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>10</update_rate>
      <topic>/gps/fix</topic>
      <always_on>true</always_on>
      <navsat>
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.5</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.0</stddev>
            </noise>
          </vertical>
        </position_sensing>
        <velocity_sensing>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.1</stddev>
          </noise>
        </velocity_sensing>
      </navsat>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

</robot>
